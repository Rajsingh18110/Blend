# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# Navar AI API key (get from your provider)
NAVAR_API_KEY=your_api_key_here

# Optional: YouTube continuation key for youtube_noapi pagination
YOUTUBEI_API_KEY=your_youtubei_key_here

# Server settings
BLEND_SECRET_KEY=change_this_to_a_random_string
BLEND_PORT=8081
BLEND_HOST=127.0.0.1

# Optional: Valkey/Redis
VALKEY_URL=redis://localhost:6379/0
